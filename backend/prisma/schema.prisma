// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  rol          UserRol  @default(DUENIO)
  activo                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?

  // Relación 1:1 con Duenio
  duenio Duenio?

  // Relación 1:1 con Coordinador
  coordinador Coordinador?

  // Relación 1:1 con Cliente
  cliente Cliente?

  // Relación 1:1 con Chofer
  chofer Chofer?

  // Relación 1:N con Liquidacion
  liquidaciones Liquidacion[]

  @@map("users")
}

model Duenio {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String
  dni       String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación 1:1 con User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación N:M con Remiseria
  remiserias RemiseriaDuenio[]

  @@map("duenios")
}

model Remiseria {
  id            String   @id @default(cuid())
  nombreFantasia String
  razonSocial   String
  cuit          String   @unique
  direccion     String
  telefono      String
  latitud       Float?
  longitud      Float?
  estado        Boolean  @default(true)
  comisionPorcentaje Float @default(30.0)
  comisionDuenioAuto Float @default(20.0)
  valorKm       Float    @default(1200)
  bajadaBandera Float    @default(3500)
  valorHoraEspera Float  @default(12000)
  tarifaEspecialActiva String?   @default("NORMAL")
  porcentajeRecargoTarifa Float  @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt


  // Relación N:M con Duenio
  duenios RemiseriaDuenio[]

  // Relación 1:N con Coordinador
  coordinadores Coordinador[]

  // Relación 1:N con Chofer
  choferes Chofer[]

  // Relación 1:N con Vehiculo
  vehiculos Vehiculo[]

  // Relación 1:N con Viaje
  viajes Viaje[]

  // Relación 1:N con Reserva
  reservas Reserva[]

  // Relación 1:N con Cliente
  clientes Cliente[]

  // Relación 1:N con ArtEmpresa
  artEmpresas ArtEmpresa[]

  @@map("remiserias")
}

model RemiseriaDuenio {
  id          String   @id @default(cuid())
  remiseriaId String
  duenioId    String   @unique
  createdAt   DateTime @default(now())

  // Relaciones
  remiseria Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)
  duenio    Duenio    @relation(fields: [duenioId], references: [id], onDelete: Cascade)

  @@unique([remiseriaId, duenioId])
  @@map("remiseria_duenio")
}

// Modelo para Coordinadores (solo nombre, email y contraseña)
model Coordinador {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación N:1 con Remiseria
  remiseriaId String
  remiseria   Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación 1:1 con User
  userId String? @unique
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coordinadores")
}

// Modelo para Clientes
model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String
  dni       String   @unique
  telefono  String
  email     String   @unique
  direccion String
  fechaNacimiento DateTime
  genero    String?  // M, F, O
  fotoUrl   String?
  direccionesFrecuentes String? // JSON array de direcciones frecuentes/favoritas
  observaciones String? // Notas del cliente (conflictivo, VIP, etc.)
  activo    Boolean  @default(true)
  
  // Cuenta Corriente y Esquema Tarifario Diferenciado (solo gestionable por el Dueño)
  cuentaCorrienteHabilitada Boolean  @default(false)
  limiteCuentaCorriente     Float?   @default(0.0)
  saldoCuentaCorriente      Float    @default(0.0)

  // Tarifas cobradas al Cliente en Cuenta Corriente (Similar a ART)
  tipoTarifa                String   @default("LISTA_NORMAL") // "LISTA_NORMAL" | "PERSONALIZADA"
  tarifaValorKm             Float?   @default(0.0) // $/km si es personalizada
  tarifaPrecioTramo         Float?   @default(0.0) // $/bajada de bandera o tramo urbano (0 a 1 km)
  tarifaValorHoraEspera     Float?   @default(0.0) // $/hora de espera si es personalizada

  // Tarifas abonadas al Chofer por viajes de este Cliente
  pagaChoferTipo            String   @default("LISTA_NORMAL") // "LISTA_NORMAL" | "PERSONALIZADO"
  choferValorKm             Float?   @default(0.0)
  choferPrecioTramo         Float?   @default(0.0)
  choferValorHoraEspera     Float?   @default(0.0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique

  // Relación 1:1 con User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación N:1 con Remiseria
  remiseriaId String?
  remiseria   Remiseria? @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación 1:N con Viaje (como cliente)
  viajes Viaje[]

  // Relación 1:N con Reserva (como cliente)
  reservas Reserva[]

  // Relación 1:N con CalificacionViaje
  calificaciones CalificacionViaje[]

  // Relación 1:N con PagosCuentaCorriente
  pagosCuentaCorriente PagoCuentaCorriente[]

  @@map("clientes")
}

// Modelo para registrar abonos y pagos parciales o totales a cuenta corriente
model PagoCuentaCorriente {
  id            String    @id @default(cuid())
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  monto         Float
  saldoAnterior Float
  saldoRestante Float
  metodoPago    String?   // EFECTIVO, TRANSFERENCIA, OTRO
  observaciones String?
  fecha         DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@map("pagos_cuenta_corriente")
}

// Modelo para Choferes
model Chofer {
  id               String   @id @default(cuid())
  numeroChofer     String   @unique
  nombre           String
  apellido         String
  dni              String   @unique
  telefono         String
  email            String?
  direccion        String?
  categoriaLicencia String
  vtoLicencia      DateTime
  estado           ChoferEstado @default(PENDIENTE_APROBACION)
  motivoRechazo    String?
  observaciones    String?
  esPropietario    Boolean  @default(false)
  comisionPorcentaje Float  @default(30.0)
  isOnline         Boolean  @default(false)
  fotoUrl          String?
  // Parada Virtual de Base
  enParadaVirtual       Boolean   @default(false)
  paradaVirtualIngreso  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relación N:1 con Remiseria
  remiseriaId String
  remiseria   Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación 1:N con Viaje
  viajes Viaje[]

  // Relación 1:N con Reserva
  reservas Reserva[]

  // Relación N:1 con Vehiculo (vehículo asignado actualmente)
  vehiculoId String?
  vehiculo   Vehiculo? @relation("ChoferVehiculo", fields: [vehiculoId], references: [id])

  // Relación 1:1 con User
  userId String? @unique
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación 1:N con Liquidacion
  liquidaciones Liquidacion[]

  // Relación 1:N con TurnoChofer
  turnos TurnoChofer[]

  // Relación 1:N con GastoChofer
  gastos GastoChofer[]

  // Relación 1:N con CalificacionViaje
  calificaciones CalificacionViaje[]

  @@index([remiseriaId, estado, isOnline])
  @@map("choferes")
}

// Modelo para Vehículos
model Vehiculo {
  id              String   @id @default(cuid())
  patente         String   @unique
  marca           String
  modelo          String
  anio            Int
  color           String
  tipo            String
  capacidad       Int
  estado          VehiculoEstado @default(ACTIVO)
  propietario     String
  vtoVtv          DateTime?
  vtoMatafuego    DateTime?
  vtoSeguro       DateTime?
  observaciones   String?
  // Campos para ubicación en tiempo real
  latitud         Float?
  longitud        Float?
  ultimaUbicacion DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relación N:1 con Remiseria
  remiseriaId String
  remiseria   Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación 1:N con Viaje
  viajes Viaje[]

  // Relación 1:N con Reserva
  reservas Reserva[]

  // Relación 1:N con Chofer (choferes asignados a este vehículo)
  choferes Chofer[] @relation("ChoferVehiculo")

  // Relación 1:N con TurnoChofer
  turnos TurnoChofer[]

  // Relación 1:N con GastoChofer
  gastos GastoChofer[]

  @@map("vehiculos")
}

// Modelo para Viajes (recaudación)
model Viaje {
  id          String   @id @default(cuid())
  origen      String
  destino     String
  precio      Decimal  @db.Decimal(10, 2)
  fecha       DateTime
  estado      ViajeEstado @default(PENDIENTE)
  observaciones String?
  // Campos adicionales para coordinación
  clienteNombre String?
  clienteTelefono String?
  clienteEmail String?
  prioridad   Prioridad @default(NORMAL)
  origenDetallado String?
  destinoDetallado String?
  // Kilometraje del viaje
  distanciaKmConPasajero Float? @default(0.0)
  distanciaKmSinPasajero Float? @default(0.0)
  metodoPago  MetodoPago? @default(EFECTIVO)
  pagaCon     Decimal? @db.Decimal(10, 2)
  vueltoEstimado Decimal? @db.Decimal(10, 2)

  // Cancelación
  motivoCancelacion    String?
  canceladoPor         String? // 'CLIENTE' | 'CHOFER' | 'COORDINADOR'
  costoCancelacion     Float?
  debeAbonarMinimo     Boolean @default(false)
  canceladoEn          DateTime?
  motivoReasignacion   String?
  choferAnteriorId     String?
  recargoTipo          String?
  recargoMonto         Float?  @default(0.0)

  // Tracking en tiempo real público
  trackingToken        String? @unique

  // Múltiples paradas y tiempo de espera
  paradas              String? // JSON array de paradas intermedias
  tiempoEsperaSegundos Int     @default(0)
  costoEspera          Float   @default(0.0)
  enEspera             Boolean @default(false)
  inicioEsperaActual   DateTime?

  // Chat rápido del viaje
  mensajesChat         String? // JSON array: [{ id, remitente, remitenteNombre, texto, timestamp }]

  // Calificación del Pasajero por parte del Chofer
  calificacionClienteEstrellas  Int?
  calificacionClienteTags        String? // JSON array
  calificacionClienteComentario  String?
  pasajeroConflictivo           Boolean   @default(false)

  // Viaje espontáneo de calle y taxímetro
  esViajeCalle                  Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación con Calificación
  calificacion CalificacionViaje?

  // Relación N:1 con Remiseria
  remiseriaId String
  remiseria   Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación N:1 con Cliente (opcional)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // Relación N:1 con Chofer (opcional, puede estar sin asignar)
  choferId String?
  chofer   Chofer? @relation(fields: [choferId], references: [id])

  // Relación N:1 con Vehiculo (opcional, puede estar sin asignar)
  vehiculoId String?
  vehiculo   Vehiculo? @relation(fields: [vehiculoId], references: [id])

  // Relación N:1 con Liquidacion
  liquidacionId String?
  liquidacion   Liquidacion? @relation(fields: [liquidacionId], references: [id])

  // Relación N:1 con ArtEmpresa
  artEmpresaId  String?
  artEmpresa    ArtEmpresa? @relation(fields: [artEmpresaId], references: [id], onDelete: SetNull)
  numeroSiniestro String?

  // Precio acordado con la ART (Privado del Dueño para facturación corporativa)
  precioArt     Decimal?    @db.Decimal(10, 2)

  @@index([remiseriaId, estado])
  @@index([choferId, estado])
  @@index([clienteId])
  @@index([createdAt])
  @@map("viajes")
}

// Modelo para Reservas
model Reserva {
  id          String   @id @default(cuid())
  clienteNombre String
  clienteTelefono String
  clienteEmail String?
  origen      String
  destino     String
  fechaInicio DateTime
  fechaFin    DateTime?
  horaInicio  String
  horaFin     String?
  diasSemana  String? // JSON array de días de la semana
  tipo        TipoReserva @default(UNICA)
  estado      ReservaEstado @default(ACTIVA)
  observaciones String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación N:1 con Remiseria
  remiseriaId String
  remiseria   Remiseria @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación N:1 con Cliente (opcional)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // Relación N:1 con Chofer (opcional)
  choferId String?
  chofer   Chofer? @relation(fields: [choferId], references: [id])

  // Relación N:1 con Vehiculo (opcional)
  vehiculoId String?
  vehiculo   Vehiculo? @relation(fields: [vehiculoId], references: [id])

  // Relación N:1 con ArtEmpresa
  artEmpresaId  String?
  artEmpresa    ArtEmpresa? @relation(fields: [artEmpresaId], references: [id], onDelete: SetNull)
  numeroSiniestro String?

  @@map("reservas")
}

// Modelo para ART y Empresas con tarifas corporativas diferenciadas
model ArtEmpresa {
  id              String      @id @default(cuid())
  nombre          String
  cuit            String?
  razonSocial     String?
  telefono        String?
  email           String?
  direccion       String?
  
  // Tarifas cobradas a la ART / Empresa (Facturación del Dueño - Privado)
  valorKm         Float       @default(0.0) // Precio por kilómetro
  precioTramo     Float       @default(0.0) // Precio por tramo (viajes locales)
  valorHoraEspera Float       @default(0.0) // Precio por hora de espera

  // Tarifas pagadas al Chofer por viajes de esta ART
  pagaChoferTipo        String      @default("LISTA_NORMAL") // "LISTA_NORMAL" | "PERSONALIZADO"
  choferValorKm         Float?      @default(0.0) // $/km abonado al chofer si es personalizado
  choferPrecioTramo     Float?      @default(0.0) // $/tramo abonado al chofer si es personalizado
  choferValorHoraEspera Float?      @default(0.0) // $/hora espera abonado al chofer si es personalizado

  activo          Boolean     @default(true)
  observaciones   String?

  // Relación con Remiseria
  remiseriaId     String
  remiseria       Remiseria   @relation(fields: [remiseriaId], references: [id], onDelete: Cascade)

  // Relación con Viajes
  viajes          Viaje[]

  // Relación con Reservas
  reservas        Reserva[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("art_empresas")
}

// Modelo para monitorear el uso de la app
model AppUsage {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  action    String   // LOGIN, CREATE_REMISERIA, CREATE_CHOFER, etc.
  details   String?  // Información adicional en formato JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("app_usage")
}

// Modelo para Calificación y Reseña de Viajes
model CalificacionViaje {
  id                String   @id @default(cuid())
  viajeId           String   @unique
  viaje             Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  choferId          String
  chofer            Chofer   @relation(fields: [choferId], references: [id], onDelete: Cascade)
  estrellasChofer   Int      @default(5)
  estrellasVehiculo Int      @default(5)
  tags              String?  // JSON array de etiquetas
  comentario        String?
  createdAt         DateTime @default(now())

  @@map("calificaciones_viajes")
}

enum UserRol {
  ADMIN
  DUENIO
  COORDINADOR
  CLIENTE
  CHOFER
}

enum VehiculoEstado {
  ACTIVO
  MANTENIMIENTO
  INACTIVO
}

enum ChoferEstado {
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
  DADO_DE_BAJA
}

enum ViajeEstado {
  PENDIENTE
  ACEPTADO
  EN_CAMINO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum Prioridad {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  CUENTA_CORRIENTE
}

enum TipoReserva {
  UNICA
  PERIODICA
}

enum ReservaEstado {
  ACTIVA
  CANCELADA
  COMPLETADA
}

model Liquidacion {
  id                  String    @id @default(cuid())
  fecha               DateTime  @default(now())
  choferId            String
  chofer              Chofer    @relation(fields: [choferId], references: [id], onDelete: Cascade)
  coordinadorId       String
  coordinador         User      @relation(fields: [coordinadorId], references: [id], onDelete: Cascade)
  totalRecaudado      Float
  combustible         Float     @default(0.0)
  comisionChofer      Float     @default(0.0)
  comisionAgencia     Float     @default(0.0)
  gananciaPropietario Float     @default(0.0)
  observaciones       String?
  createdAt           DateTime  @default(now())

  // Relación con los viajes asociados a este cierre
  viajes              Viaje[]

  @@map("liquidaciones")
}

// Modelo para Turnos / Jornada del Chofer (Tracking de Kilometraje)
model TurnoChofer {
  id               String    @id @default(cuid())
  choferId         String
  chofer           Chofer    @relation(fields: [choferId], references: [id], onDelete: Cascade)
  vehiculoId       String?
  vehiculo         Vehiculo? @relation(fields: [vehiculoId], references: [id])
  
  fechaInicio      DateTime  @default(now())
  fechaFin         DateTime?
  activo           Boolean   @default(true)

  // Métricas acumuladas de Kilometraje
  kmTotalConectado Float     @default(0.0)
  kmConPasajero    Float     @default(0.0)
  kmSinPasajero    Float     @default(0.0)

  // Odómetro manual opcional del vehículo
  odometroInicio   Float?
  odometroFin      Float?
  observaciones    String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([choferId, activo])
  @@map("turnos_chofer")
}

// Modelo para Gastos del Chofer (Combustible, Reparaciones, etc.)
model GastoChofer {
  id                 String           @id @default(cuid())
  choferId           String
  chofer             Chofer           @relation(fields: [choferId], references: [id], onDelete: Cascade)
  vehiculoId         String?
  vehiculo           Vehiculo?        @relation(fields: [vehiculoId], references: [id])
  
  tipo               TipoGasto
  subtipoCombustible TipoCombustible? // NAFTA_GASOIL o GNC
  monto              Float
  fecha              DateTime         @default(now())
  kilometraje        Float?           // Km del odómetro al registrar el gasto
  litros             Float?           // Litros (Nafta/Gasoil) o m3 (GNC)
  descripcion        String?
  comprobanteUrl     String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("gastos_chofer")
}

enum TipoCombustible {
  NAFTA_GASOIL
  GNC
}

enum TipoGasto {
  COMBUSTIBLE
  REPARACION
  MANTENIMIENTO
  PEAJE
  LAVADO
  OTRO
}
 