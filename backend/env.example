# Database
DATABASE_URL="postgresql://username:password@localhost:5432/app_remises"
DIRECT_URL="postgresql://username:password@localhost:5432/app_remises"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000"

# Email - Resend
RESEND_API_KEY=""
FROM_EMAIL=""
FROM_NAME="App Remises"

# ==========================================
# VALIDACIÓN DE IDENTIDAD - ARCA (ex-AFIP)
# ==========================================
# Opción 1: Gateway / REST API de Padrón ARCA (Recomendada para facilidad y rapidez)
# ARCA_API_URL="https://arca.api.com.ar"
# ARCA_API_KEY="tu_api_key_de_padron"

# Opción 2: Web Service Oficial SOAP de ARCA (ws_sr_padron_a13 con Certificado y Clave)
# AFIP_CUIT="20123456789"
# AFIP_CERT="ruta_o_contenido_del_certificado.crt"
# AFIP_KEY="ruta_o_contenido_de_la_clave_privada.key"
# AFIP_PRODUCTION="false"

# Nota: Si no se configuran credenciales en desarrollo, el sistema activa automáticamente
# el modo Sandbox asistido calculando el CUIL por Módulo 11 y proveyendo datos verificados
# de prueba para que la aplicación nunca se interrumpa.
