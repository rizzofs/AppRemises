# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND - APP REMISES
# ==============================================================================

# 1. URL de la API del Backend en Render (debe terminar en /api)
NEXT_PUBLIC_API_URL=https://appremisesbruno.onrender.com/api

# 2. URL de WebSockets para tracking en vivo y despacho (URL base sin /api)
NEXT_PUBLIC_SOCKET_URL=https://appremisesbruno.onrender.com

# 3. Google Maps API Key (Opcional - Si no se define, se utiliza OpenStreetMap/Leaflet gratuito)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
